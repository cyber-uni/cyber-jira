{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "cyber-jira",
	"version": "0.1.0",
	"description": "Agent skills for Jira, driving the jira CLI",
	"author": {
		"name": "unional"
	},
	"homepage": "https://cyber-uni.github.io/cyber-jira/",
	"repository": "https://github.com/cyber-uni/cyber-jira.git",
	"license": "MIT",
	"keywords": ["jira", "cli", "agent", "productivity", "project-management"],
	"extensions": {
		"org.cyberuni.universal-plugin": {
			"skills": "./skills/",
			"vendors": ["claude-code", "cursor", "codex", "copilot-cli"],
			"harnesses": {
				"cursor": {
					"category": "productivity",
					"tags": ["jira", "project-management"]
				},
				"codex": {
					"interface": {
						"displayName": "Cyber Jira",
						"category": "productivity"
					}
				}
			}
		}
	}
}
